# ─────────────────────────────────────────────────────────
# AI QA Assistant — Environment Variables Template
# Copy this file to `server/.env` and adjust values as needed
# ─────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# Client origin for CORS
CLIENT_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────
# Security & Access Control
# ─────────────────────────────────────────────────────────
# Secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=replace_with_a_secure_random_secret_string

# Email automatically assigned the Owner / Admin role on first registration/login
ADMIN_EMAIL=admin@example.com

# ─────────────────────────────────────────────────────────
# AI Providers — Add at least ONE key to enable generation
# ─────────────────────────────────────────────────────────

# ① Google Gemini (FREE — no credit card required)
#    Get your key at: https://aistudio.google.com → "Get API key"
#    Free limits: 15 RPM, 1500 RPD, 1M TPM (Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# ② Groq — Llama 3.3 70B / Llama 3 8B (FREE — no credit card required)
#    Get your key at: https://console.groq.com → API Keys → Create API Key
#    Free limits: 30 RPM, 1000 RPD (Groq Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here

# ─────────────────────────────────────────────────────────
# Database (Optional — Zero-Config In-Memory Fallback)
# ─────────────────────────────────────────────────────────
# If MongoDB is not provided, the application automatically runs
# on a high-speed local In-Memory / JSON storage engine.
MONGO_URI=mongodb://127.0.0.1:27017/ai-qa-assistant

# ─────────────────────────────────────────────────────────
# Jira Watchlist Polling (Optional)
# ─────────────────────────────────────────────────────────
# Watchlist polling interval in milliseconds (default: 5 minutes)
JIRA_POLL_INTERVAL_MS=300000

# Comma-separated Jira statuses triggering QA notifications
JIRA_READY_STATUSES=Ready for QA,In QA,Done,Resolved,Merged

# ─────────────────────────────────────────────────────────
# AI QA Assistant — Backend Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# Client origin for CORS
CLIENT_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────
# AI Providers — add at least ONE key to enable generation
# ─────────────────────────────────────────────────────────

# ① Google Gemini (FREE — no credit card required)
#    Get your key at: https://aistudio.google.com → "Get API key"
#    Free limits: 15 RPM, 1500 RPD, 1M TPM (Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# ② Groq — Llama 4 Scout / Llama 3 70B (FREE — no credit card required)
#    Get your key at: https://console.groq.com → API Keys → Create API Key
#    Free limits: 30 RPM, 1000 RPD, 30K TPM (Llama 4 Scout)
GROQ_API_KEY=your_groq_api_key_here

# ─────────────────────────────────────────────────────────
# Database (optional — needed for History feature)
# ─────────────────────────────────────────────────────────
# MONGO_URI=mongodb://localhost:27017/ai-qa-assistant
